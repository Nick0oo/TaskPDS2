{
  "compilerOptions": {
    "target": "es2020",
    "module": "esnext",
    "moduleResolution": "node",
    "lib": ["es2020"],
    "rootDir": "src",
    "outDir": "dist",
    "baseUrl": "src",
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "types": ["node"],
    "strict": true
  },
  "include": ["src"]
}
